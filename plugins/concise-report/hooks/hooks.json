{
  "description": "Blocks a reply that is too long on Stop and asks for a short, results-only report.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/check-long-reply.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
