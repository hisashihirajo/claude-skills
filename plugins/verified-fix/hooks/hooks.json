{
  "description": "Blocks a fix claim on Stop unless the reply has a Verified: or Unverified: line.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/check-fix-claim.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
